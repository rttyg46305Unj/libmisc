fn printoct(cell n, cell tdlb){
  cell two = 2;
  cell six = 6;
  cell five = 5;
  cell fdig = n;
  tshift_r(fdig, six);
  tshift_l(tdlb, two);
  output 48+fdig+tdlb;
  cell sdig = n;
  tshift_l(sdig, two);
  tshift_r(fdig, five);
  output 48+sdig;
  cell tdig = n;
  tshift_l(sdig, five);
  tshift_r(fdig, five);
  output 48+tdig;
}

fn printoct(cell n){
  cell zero = 0;
