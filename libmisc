fn printheader(cell base){
  output 48;
  cell inequalities = 3;
  if not base - binary {
    inequalities-=1;
    output 'b';
  }
  if not base - octal {
    inequalities-=1;
    output 'o';
  }
  if not base - hexadecimal {
    inequalities-=1;
    output 'x';
  }
  if not inequalities - 3 {
    output '?';
  }
}

// BOOLEAN

fn and(cell a, cell b, cell out){
  cell a1 = a;
  cell b1 = b;
  out = 0;
  if a1 {out+=1;}
  if b1 {out+=1;}
  if not out - 2 {out = 1;} else {out = 0;}
}

fn xor(cell a, cell b, cell out){
  cell a1 = a;
  cell b1 = b;
  out = 0;
  if a1 {out+=1;}
  if b1 {out+=1;}
  if not out - 1 {out = 1;} else {out = 0;}
}

fn or(cell a, cell b, cell out){
  cell a1 = a;
  cell b1 = b;
  out = 0;
  if a1 {out=1;}
  if b1 {out=1;}
}

fn less(cell a, cell b, cell out){
  cell andout;
  cell a1 = a;
  cell b1 = b;
  out = 1;
  and(a1, b1, andout);
  while andout{
    a1-=1;
    b1-=1;
    and(a1, b1, andout);
  }
  if a1 {out = 0;}
  and(b1, out, out);
}

