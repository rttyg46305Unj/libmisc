}

fn div_10(cell self) {
  cell quotient;
  cell dividing = 1;
  while dividing {
    drain 10 {
      dividing = 0;
      if self {
        dividing = 1;
        self-=1;
      }
    }
    if dividing {
      quotient+=1;
    }
  }
  self = quotient;
}

fn printhex(cell n, cell lower){
  cell idkwhat = 7;
  if lower{
    idkwhat += 32;
  }
  cell four = 4;
  cell topn = n;
  tshift_r(topn, four);
  cell botn = n;
  wshift_l(botn, four);
  tshift_r(botn, four);
  cell topnt = topn;
  div_10(topnt);
  cell topntv;
  if topnt {topntv = idkwhat;}
  output 48+topn+topntv;
  cell botnt = botn;
  div_10(botnt);
  cell botntv;
  if botnt {botntv = idkwhat;}
  output 48+botn+botntv;
}

fn printhex(cell n){
  cell zero;
  printhex(n, zero)
}

fn printhex(struct u16 n, cell lower){
  printhex(n.n1, lower);
  printhex(n.n0, lower);
}

fn printhex(struct u16 n){
  cell zero;
