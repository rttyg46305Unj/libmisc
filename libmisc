// MATH

fn mult(cell a, cell b, cell out){
  cell a1 = a;
  out = 0;
  drain a1{
    out += b;
  }
}

fn divmod(cell n, cell divisor, cell mod, cell div){
  cell[6] cells;
  cell nodiv;
  lessequal(divisor, binary, nodiv);
  if not nodiv{
    cells[0] = n;
    cells[1] = divisor;
    bf @cells[0]{ // divmod alogrithm
      [->-[>+>>]>[+[-<+>]>+>>]<<<<<]
    }
    div = cells[3];
    mod = cells[2];
  }
  else{
    div = n;
    mod = 0;
  }
}

fn pow(cell n, cell exponent, cell out){
  out = 1;
  cell exponent1 = exponent;
  drain exponent1 {
    mult(out, n, out);
  }
}

fn log(cell base, cell n, cell out){
  out = 1;
  cell powout = 0;
  cell leout = 0;
  pow(base, out, powout);
  lessequal(powout, n, leout);
  while leout{
    out+=1;
    pow(base, out, powout);
    lessequal(powout, n, leout);
  }
  out-=1;
}

fn root(cell base, cell n, cell out){
  out = 1;
  cell powout = 0;
  cell leout = 0;
  pow(out, base, powout);
  lessequal(powout, n, leout);
  while leout{
    out+=1;
    pow(out, base, powout);
    lessequal(powout, n, leout);
  }
  out-=1;
}