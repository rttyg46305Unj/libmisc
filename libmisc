// RANDOM

fn random(cell t, cell j){
  cell u;
  cell f = 5;
  t-=1;
  u=t;
  tshift_r(u,f);
  wshift_l(j, u);
  u=j;
  tshift_r(u,f);
  wshift_l(t, u);
  j+=t;
}

fn random(struct u16 s){
