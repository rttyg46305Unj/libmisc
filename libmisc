fn printheader(cell base){
  output 48;
  cell inequalities = 3;
  if not base - 2 {
    inequalities-=1;
    output 'b';
  }
  if not base - 8 {
    inequalities-=1;
    output 'o';
  }
  if not base - 16 {
    inequalities-=1;
    output 'x';
  }
  if not inequalities - 3 {
    output '?';
  }
}